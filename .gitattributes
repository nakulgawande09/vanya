* text=auto eol=lf
*.gd text
*.tscn text
*.tres text
*.godot text
*.cfg text
*.import text
*.svg text
*.json text
*.csv text
*.md text
*.sh text eol=lf

# Binary assets go through Git LFS (install with `git lfs install` before adding any)
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.pck filter=lfs diff=lfs merge=lfs -text
*.aab filter=lfs diff=lfs merge=lfs -text
# Fonts are committed as plain files (small, rarely change); see docs/adr/0005.
*.ttf binary
*.otf binary
