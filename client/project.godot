; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vanya: Guardians of the Grove"
config/description="Warli-inspired 2D action roguelite."
config/version="0.1.0"
run/main_scene="res://ui/screens/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0862745, 0.141176, 0.121569, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Boot="*res://autoload/boot.gd"
EventBus="*res://autoload/event_bus.gd"
Services="*res://autoload/services.gd"
AdaptiveQuality="*res://autoload/adaptive_quality.gd"
ThemeRegistry="*res://autoload/theme_registry.gd"
SceneRouter="*res://autoload/scene_router.gd"

[debug]

gdscript/warnings/directory_rules={
"res://addons": 0
}
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[gui]

theme/custom="res://themes/grove_default/ui_theme.tres"

[input]

pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.hi.translation", "res://localization/strings.mr.translation")
locale/fallback="en"

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="player_hurt"
2d_physics/layer_3="enemy"
2d_physics/layer_4="enemy_hurt"
2d_physics/layer_5="player_proj"
2d_physics/layer_6="enemy_proj"
2d_physics/layer_7="walls"
2d_physics/layer_8="pickups"

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0862745, 0.141176, 0.121569, 1)
